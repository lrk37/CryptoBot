# ==============================================================================
# CryptoBot Environment Configuration (.env)
# ==============================================================================

# Target Environment: Set to True for Binance Spot Testnet (safe default), False for Live trading
USE_TESTNET=True

# Live Binance API Credentials (https://www.binance.com/en/my/settings/api-management)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Optional Binance Spot Testnet Credentials (https://testnet.binance.vision/)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Optional Telegram Notifications
ENABLE_TELEGRAM=False
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# DISPLAY_TIMEZONE=Europe/Belgrade  # DST-aware CET (UTC+1) / CEST (UTC+2)

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=bot.log

# Position Sizing & Strategy Overrides (optional — avoids editing config.py directly)
# MAX_TRADE_USDT=60            # Max USDT per trade (set 0 to auto-compound SCANNER_TRADE_PCT% of USDT balance)
# MAX_OPEN_TRADES=1            # Concurrent positions (can raise to 2 when account >= $200)
# USE_RISK_BASED_SIZING=True   # Scale position size down when stop-loss is wide
# USE_LIMIT_MAKER_ENTRY=True   # Post-only LIMIT_MAKER bid chase (6s) before Market fallback
# MIN_SCAN_VOLUME_USDT=20000000
# MIN_LISTING_AGE_DAYS=60
# ENABLE_FUTURES_CONFIRMATION=True
# WARN_ZERO_BNB=True           # Warn in logs & Telegram if BNB fee reserve hits 0 or < $1.00

# Optional Live Dashboard Password (enables HTTP Basic Auth on dashboard.py when set)
# DASHBOARD_PASSWORD=choose_a_strong_password
