# ==============================================================================
# CryptoBot Environment Configuration (.env)
# ==============================================================================

# Target Environment: Set to True for Binance Spot Testnet, False for Live trading
USE_TESTNET=False

# Live Binance API Credentials (https://www.binance.com/en/my/settings/api-management)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Optional Binance Spot Testnet Credentials (https://testnet.binance.vision/)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Optional Telegram Notifications
ENABLE_TELEGRAM=False
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=bot.log
