[Unit]
Description=CryptoBot Read-Only Live Web Dashboard
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/CryptoBot
ExecStart=/home/ubuntu/CryptoBot/venv/bin/python /home/ubuntu/CryptoBot/dashboard.py --host 127.0.0.1 --port 8050
Restart=on-failure
RestartSec=5
EnvironmentFile=-/home/ubuntu/CryptoBot/.env

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
