[Unit]
Description=CryptoBot Automated Spot Trading Daemon
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/CryptoBot
ExecStart=/home/ubuntu/CryptoBot/venv/bin/python bot.py
Restart=always
RestartSec=10
EnvironmentFile=/home/ubuntu/CryptoBot/.env

# Standard output and error logging (sent to systemd journal; python FileHandler writes to bot.log)
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
